rules_version = '2';

/**
 * Firestore security rules.
 *
 * The game server writes results using the Admin SDK, which bypasses these
 * rules entirely. That is what lets everything here be read-mostly: no client
 * may write a match record or touch a win/loss count, so a player cannot
 * manufacture a result or edit their own record.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** Fields a player is allowed to change on their own profile. */
    function onlyDisplayFieldsChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['displayName', 'photoURL']);
    }

    function validDisplayName() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60;
    }

    match /users/{uid} {
      // Profiles are public to signed-in players so opponent names, the
      // leaderboard, and match history can render.
      allow read: if signedIn();

      // Creation is the server's job (on first connection). A client creating
      // its own document could seed itself a fabricated record.
      allow create: if false;

      // A player may correct their own display name or picture, and nothing
      // else. Stats are server-owned.
      allow update: if isSelf(uid) && onlyDisplayFieldsChanged() && validDisplayName();

      allow delete: if false;
    }

    match /match_records/{matchId} {
      // Results are readable so players can see their history and the
      // leaderboard. They are never client-writable at all: every result comes
      // from the authoritative game server.
      allow read: if signedIn();
      allow write: if false;
    }

    // Anything not named above is denied, including collections a future
    // feature might add before its rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
