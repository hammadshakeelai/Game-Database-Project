# ---------------------------------------------------------------
# Firebase web config (client)
#
# These are public identifiers, not secrets: they ship in the browser
# bundle by design, and access is controlled by Firestore security rules
# and the authorised-domains list. They live here so the same build can
# point at a different project without a code change.
#
# Find them in: Firebase console -> Project settings -> Your apps -> Web app
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------

# Service-account JSON for firebase-admin, as ONE line.
# This IS a secret. Never commit it; set it in your host's environment.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Comma-separated browser origins allowed to open a socket in production.
CLIENT_ORIGIN=https://your-app.onrender.com

# Injected by the host. Only set this locally if 3000 is taken.
# PORT=3000

# ---------------------------------------------------------------
# Local development with the Firebase emulators
#
# `npm run dev:emulators` and `npm run test:integration` set these
# automatically. You only need them for a hand-rolled emulator run.
# ---------------------------------------------------------------
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9399
# FIRESTORE_EMULATOR_HOST=localhost:8391
# VITE_AUTH_EMULATOR_HOST=localhost:9399
